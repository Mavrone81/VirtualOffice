# Environment template for local development and tests.
# Copy to .env and fill in real values — .env is gitignored, never commit it.
# The full contract (required vs optional, defaults) is enforced at startup
# by lib/env.ts; this file lists every variable it reads.

# --- Database (required) -----------------------------------------------
# Local dev: docker-compose.yml brings up Postgres on 10501 with these
# credentials. For a throwaway test DB, point this at your own container
# instead (see reviews/test-baseline.md for the pattern this team uses).
DATABASE_URL="postgresql://virtualoffice:virtualoffice_dev@localhost:10501/virtualoffice"
# Optional: a second connection string for migrations/introspection when
# DATABASE_URL goes through a pooler (e.g. PgBouncer). Leave unset otherwise.
# DIRECT_URL="postgresql://virtualoffice:virtualoffice_dev@localhost:10501/virtualoffice"

# --- Auth (required) -----------------------------------------------------
# NextAuth v5 session secret. Left commented so a copied .env fails to boot
# (lib/env.ts requires this) until you set a real one, rather than silently
# starting with a publicly-known secret. Generate one with:
#   openssl rand -base64 32
# AUTH_SECRET=""

# Absolute base URL used to build links in emails (onboarding invite, temp
# password) and password-reset links. Optional in dev — falls back to the
# request's Host header if unset. REQUIRED in production: without it those
# links are built from the client-supplied x-forwarded-host header.
# AUTH_URL="http://localhost:10502"

# --- PII encryption (required) -------------------------------------------
# AES-256-GCM key for NRIC / bank account number columns, as 64 hex chars
# (32 bytes). Generate a real one with:
#   openssl rand -hex 32
# NEVER reuse a real/prod key here or in any committed file.
PII_ENCRYPTION_KEY="change-me-generate-64-hex-chars-with-openssl-rand-hex-32"
# Optional: the previous key, kept only during a key-rotation window so old
# ciphertext still decrypts. Unset once rotation is complete.
# PII_ENCRYPTION_KEY_PREVIOUS=""

# --- Object storage (optional, has a default) -----------------------------
# Local-filesystem root for uploads (photos, signatures, signed agreements).
# Defaults to a repo-relative ".uploads" folder; in prod this is a mounted
# Docker volume (/data/uploads) — see docker-compose.prod.yml.
# STORAGE_DIR=".uploads"

# --- Transactional email (all optional) -----------------------------------
# When SMTP_HOST is unset, mail is logged instead of sent — dev/build/CI
# work fine with none of these set.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASSWORD="change-me"
# SMTP_SECURE="false"
# EMAIL_FROM="Enshrine Virtual Office <no-reply@enshrine.com.sg>"
# EMAIL_REPLY_TO="admin@enshrine.com.sg"

# --- Business rules (all optional, have defaults) -------------------------
# INVOICE_NUMBER_FORMAT="INV-{COMPANY}-{YYYY}-{SEQ}"
# INVOICE_MODE="per-company" # or "consolidated"
# COMMISSION_PAYOUT_INSTALLMENT_THRESHOLD="3"
# OVERRIDE_CHAIN_DEPTH="2"

# --- Admin AI assistant (optional) ----------------------------------------
# Server-side only, never sent to the browser. When unset, the assistant
# endpoint returns a friendly "not configured" message instead of failing.
# ANTHROPIC_API_KEY="change-me"
# ANTHROPIC_MODEL="claude-opus-4-8"

# --- Feature flags (all optional, default false/off) -----------------------
# PAYMENT_GATEWAY_ENABLED="false"
# FESTIVE_AI_ENABLED="false"
# GST_ENABLED="false"
# GST_RATE="9"

# --- Misc (optional, has a default) ----------------------------------------
# TZ="Asia/Singapore"
